{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "$id" : "https://nl-portal.nl/schema/tenant.schema.json",
  "title" : "NL Portal tenantbestand",
  "description" : "Niet-geheime inrichting van een tenant in een omgeving. Een OIN moet tussen aanhalingstekens staan. Het bestand heet <oin>.yaml; base.yaml in dezelfde map is de gedeelde basis voor die omgeving.",
  "type" : "object",
  "properties" : {
    "oin" : {
      "type" : "string",
      "pattern" : "^[0-9]{20}$"
    },
    "naam" : {
      "type" : "string",
      "minLength" : 1
    },
    "omgevingstype" : {
      "type" : "string",
      "enum" : [ "productie", "acceptatie", "test", "ontwikkeling" ]
    },
    "domeinen" : {
      "type" : "array",
      "items" : {
        "type" : "string",
        "pattern" : "^(?=.{1,253}$)(?![0-9.]+$)[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?)*$"
      },
      "minItems" : 1
    },
    "thema" : {
      "type" : "object",
      "properties" : {
        "titel" : {
          "type" : "string",
          "minLength" : 1
        },
        "logo" : {
          "type" : "string",
          "minLength" : 1
        },
        "favicon" : {
          "type" : "string",
          "minLength" : 1
        },
        "stijl" : {
          "type" : "string",
          "minLength" : 1
        }
      },
      "required" : [ "titel" ],
      "additionalProperties" : false
    },
    "inlogmiddelen" : {
      "type" : "array",
      "items" : {
        "type" : "string",
        "enum" : [ "digid", "eherkenning", "wallet", "test" ]
      },
      "minItems" : 1
    },
    "minimumNiveau" : {
      "type" : "string",
      "enum" : [ "basis", "midden", "substantieel", "hoog" ]
    },
    "sessie" : {
      "type" : "object",
      "properties" : {
        "inactiviteit" : {
          "type" : "string",
          "pattern" : "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
          "description" : "ISO-8601-duur, bijvoorbeeld PT15M"
        },
        "absoluut" : {
          "type" : "string",
          "pattern" : "^P(?!$)(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
          "description" : "ISO-8601-duur, bijvoorbeeld PT15M"
        }
      },
      "additionalProperties" : false
    }
  },
  "required" : [ "oin", "naam", "omgevingstype", "domeinen", "thema", "inlogmiddelen" ],
  "additionalProperties" : false
}
