# =============================================================================
# NL Portal Backend Configuration
# =============================================================================
# This file configures the Spring Boot backend for nl-portal-app.
# Environment variables follow Spring Boot relaxed binding:
#   nl-portal.config.module.property → NLPORTAL_CONFIG_MODULE_PROPERTY
#
# Required services (docker-compose profiles):
#   - Keycloak: always required
#   - zgw: OpenZaak, ObjectenAPI, etc.
#   - haalcentraal: BRP/Bewoning mocks
# =============================================================================

# -----------------------------------------------------------------------------
# Authentication - BFF (ADR 0022)
# De backend logt de burger in bij de Keycloak-realm van de tenant (client nl-portal-backend, private_key_jwt). De client-
# registratie (issuer, clientsleutel) staat in het tenantbestand (imports/tenants); hier alleen wat voor de hele runtime geldt.
# -----------------------------------------------------------------------------
# Publieke basis-URL van Keycloak: de issuer van elke tenant moet eronder vallen.
KEYCLOAK_BROKER_URL=http://localhost:8082
# Redis voor de sessies: host, gebruiker en wachtwoord komen uit compose.yaml en docker-compose/.env (REDIS_PASSWORD).
# REDIS_SSL staat standaard aan; compose.yaml zet hem uit voor de Redis van de stack.

# -----------------------------------------------------------------------------
# Authentication - Machtigingsdienst (optional)
# -----------------------------------------------------------------------------
#NLPORTAL_AUTHENTICATION_MACHTINGSDIENST_RESOURCEURL=
#NLPORTAL_AUTHENTICATION_MACHTINGSDIENST_ALLMACHTIGINGUUID=

# -----------------------------------------------------------------------------
# Security - CORS
# De backend staat standaard geen cross-origin verzoeken toe. Onderstaande ruime
# waarden zijn alleen voor de lokale compose-stack; zet in een echte omgeving
# expliciete origins (zie site/hosting-en-configuratie/deployment-guide.md).
# -----------------------------------------------------------------------------
NLPORTAL_SECURITY_CORS_0_PATH=/**
NLPORTAL_SECURITY_CORS_0_CONFIG_ALLOWEDORIGINS=*
NLPORTAL_SECURITY_CORS_0_CONFIG_ALLOWEDMETHODS=GET,POST,PUT,DELETE,OPTIONS
NLPORTAL_SECURITY_CORS_0_CONFIG_ALLOWEDHEADERS=*

# -----------------------------------------------------------------------------
# Security - Endpoints (optional)
# -----------------------------------------------------------------------------
#NLPORTAL_SECURITY_ENDPOINTS_UNSECURED=/actuator/health

# -----------------------------------------------------------------------------
# Security - Headers (optional)
# -----------------------------------------------------------------------------
#NLPORTAL_SECURITY_HEADERS_CONTENTSECURITYPOLICY=default-src 'self'
#NLPORTAL_SECURITY_HEADERS_HSTSMAXAGEINDAYS=365

# -----------------------------------------------------------------------------
# Theme (optional)
# -----------------------------------------------------------------------------
#NLPORTAL_CONFIG_THEME_STYLE=
#NLPORTAL_CONFIG_THEME_LOGO=

# -----------------------------------------------------------------------------
# Open Object
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_OBJECTENAPI_ENABLED=true
# De URL staat in het tenantbestand (koppelingen.objectenapi); het geheim (NL_PORTAL_GEHEIMEN_<OIN>_OBJECTENAPI_TOKEN) komt uit docker-compose/.env (OBJECTS_API_TOKEN, gegenereerd door `mise run dev:setup`); zie compose.yaml.

# -----------------------------------------------------------------------------
# Zaken API
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_ZAKENAPI_ENABLED=true
# De URL, het client-ID en het geheim van de Zaken API staan in het tenantbestand (docker-compose/imports/tenants, `koppelingen.zakenapi`);
# het geheim komt uit docker-compose/.env (OPENZAAK_NLPORTAL_SECRET, gegenereerd door `mise run dev:setup`) als NL_PORTAL_GEHEIMEN_<OIN>_ZAKEN_SECRET; zie compose.yaml.
# Uitgesloten zaaktypen en de KvK-zoekwijze staan onder `modules.zakenapi` in hetzelfde bestand.

# -----------------------------------------------------------------------------
# Catalogi API
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_CATALOGIAPI_ENABLED=true
# De URL en het client-ID van de Catalogi API staan in het tenantbestand (`koppelingen.catalogiapi`); het geheim (NL_PORTAL_GEHEIMEN_<OIN>_CATALOGIAPI_SECRET)
# komt uit docker-compose/.env (OPENZAAK_NLPORTAL_SECRET, gegenereerd door `mise run dev:setup`); zie compose.yaml.

# -----------------------------------------------------------------------------
# Besluiten API
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_BESLUITENAPI_ENABLED=true
NLPORTAL_CONFIG_BESLUITENAPI_PROPERTIES_URL=http://nl-portal-openzaak.test:8001
NLPORTAL_CONFIG_BESLUITENAPI_PROPERTIES_CLIENTID=nl-portal
# NLPORTAL_CONFIG_BESLUITENAPI_PROPERTIES_SECRET komt uit docker-compose/.env (OPENZAAK_NLPORTAL_SECRET, gegenereerd door `mise run dev:setup`); zie compose.yaml.

# -----------------------------------------------------------------------------
# Documenten API
# Alleen de schakelaar staat hier. De documenten-API's (koppelingen) en de gegevens per tenant (standaard document-API, witlijsten,
# rsin, documenttype) staan in docker-compose/imports/tenants/<oin>.yaml; de geheimen komen uit docker-compose/.env
# (NL_PORTAL_GEHEIMEN_<OIN>_DOCUMENTEN_API_SECRET en NL_PORTAL_GEHEIMEN_<OIN>_DOCUMENTEN_DUMMYDOC_SECRET, zie compose.yaml).
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_DOCUMENTENAPIS_ENABLED=true

# -----------------------------------------------------------------------------
# ClamAV Virus Scan (optional)
# Start the scanner with the `clamav` compose profile, then flip ENABLED to true.
# De scanner draait onder de hostname nl-portal-clamav (compose-netwerk); een bootRun op de host gebruikt localhost.
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_VIRUSSCAN_CLAMAV_ENABLED=true
NLPORTAL_CONFIG_VIRUSSCAN_CLAMAV_PROPERTIES_HOSTNAME=nl-portal-clamav
NLPORTAL_CONFIG_VIRUSSCAN_CLAMAV_PROPERTIES_PORT=3310

# -----------------------------------------------------------------------------
# OpenKlant 2
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_OPENKLANT2_ENABLED=true
NLPORTAL_CONFIG_OPENKLANT2_PROPERTIES_CONTACTGEGEVENSAPIURL=http://nl-portal-openklant-2:8014/contactgegevens/api/v1
NLPORTAL_CONFIG_OPENKLANT2_PROPERTIES_KLANTINTERACTIESAPIURL=http://nl-portal-openklant-2:8014/klantinteracties/api/v1
# NLPORTAL_CONFIG_OPENKLANT2_PROPERTIES_TOKEN komt uit docker-compose/.env (OPENKLANT_API_TOKEN, gegenereerd door `mise run dev:setup`); zie compose.yaml.
#NLPORTAL_CONFIG_OPENKLANT2_PROPERTIES_DIGITALADRESSENREFERENTIE=

# -----------------------------------------------------------------------------
# Taak
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_TAAK_ENABLED=true

# -----------------------------------------------------------------------------
# Form
# -----------------------------------------------------------------------------
# Validates fetched objecten api form definitions have this objecttype; validation is skipped if unset.
NLPORTAL_CONFIG_FORM_PROPERTIES_FORMDEFINITIONOBJECTTYPEURL=http://nl-portal-open-object:8010/api/v2/objecttypes/4b5f4fba-0746-11ed-b939-0242ac120002

# -----------------------------------------------------------------------------
# OpenProduct (optional)
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_OPENPRODUCT_ENABLED=true
#NLPORTAL_CONFIG_OPENPRODUCT_PROPERTIES_PRODUCTAPIURL=http://localhost:8015/producten/api/v1
#NLPORTAL_CONFIG_OPENPRODUCT_PROPERTIES_PRODUCTTYPEAPIURL=http://localhost:8015/producttypen/api/v1
#NLPORTAL_CONFIG_OPENPRODUCT_PROPERTIES_TOKEN=
#NLPORTAL_CONFIG_OPENPRODUCT_PROPERTIES_DMN_CLIENTID=
#NLPORTAL_CONFIG_OPENPRODUCT_PROPERTIES_DMN_SECRET=
#NLPORTAL_CONFIG_OPENPRODUCT_PROPERTIES_DMN_USERNAME=
#NLPORTAL_CONFIG_OPENPRODUCT_PROPERTIES_DMN_PASSWORD=

# -----------------------------------------------------------------------------
# HaalCentraal BRP
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_HAALCENTRAALBRP_ENABLED=true
# De bron en de velden staan per tenant in het tenantbestand (koppelingen.brp, koppelingen.brp-bewoning en modules.brp,
# zie imports/tenants). De mocks vragen geen sleutel (auth.type: geen), dus hier staat geen geheim.

# -----------------------------------------------------------------------------
# KVK (Handelsregister, optional)
# -----------------------------------------------------------------------------
#NLPORTAL_CONFIG_KVK_ENABLED=false
# Aan alleen met een tenant die koppelingen.kvk heeft; anders weigert het opstarten.
# De bron staat per tenant in het tenantbestand (koppelingen.kvk, zie imports/tenants); de sleutel is het geheim <oin>.kvk-sleutel:
#NL_PORTAL_GEHEIMEN_00000099000000000001_KVK_SLEUTEL=
# Vervallen (starten weigert zolang ze gezet zijn): NLPORTAL_CONFIG_KVK_PROPERTIES_* (URL, APIKEY, SSL_*). Clientcertificaten vervallen: de cloud gateway doet mTLS.

# -----------------------------------------------------------------------------
# Product Module
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_PRODUCT_ENABLED=true
NLPORTAL_CONFIG_PRODUCT_PROPERTIES_PRODUCTTYPEURL=http://nl-portal-open-object:8010/api/v2/objecttypes/972e92ce-b964-4ca8-ad4d-ddc43dd7b244
NLPORTAL_CONFIG_PRODUCT_PROPERTIES_PRODUCTINSTANTIETYPEURL=http://nl-portal-open-object:8010/api/v2/objecttypes/3e852115-277a-4570-873a-9a64be3aeb34
NLPORTAL_CONFIG_PRODUCT_PROPERTIES_PRODUCTVERBRUIKSOBJECTTYPEURL=http://nl-portal-open-object:8010/api/v2/objecttypes/3e852115-277a-4570-873a-9a64be3aeb37
NLPORTAL_CONFIG_PRODUCT_PROPERTIES_PRODUCTDETAILSTYPEURL=http://nl-portal-open-object:8010/api/v2/objecttypes/3e852115-277a-4570-873a-9a64be3aeb36

# -----------------------------------------------------------------------------
# Prefill
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_PREFILL_ENABLED=true
NLPORTAL_CONFIG_PREFILL_PROPERTIES_TYPEURL=http://nl-portal-open-object:8010/api/v2/objecttypes/3e852115-277a-4570-873a-9a64be3aeb37

# -----------------------------------------------------------------------------
# DMN (Decision Management)
# -----------------------------------------------------------------------------
NLPORTAL_CONFIG_DMN_ENABLED=true
NLPORTAL_CONFIG_DMN_PROPERTIES_URL=http://nl-portal-open-object:8010
#NLPORTAL_CONFIG_DMN_PROPERTIES_CLIENTID=
#NLPORTAL_CONFIG_DMN_PROPERTIES_SECRET=
#NLPORTAL_CONFIG_DMN_PROPERTIES_USERNAME=
#NLPORTAL_CONFIG_DMN_PROPERTIES_PASSWORD=
#NLPORTAL_CONFIG_DMN_PROPERTIES_SSL_ENABLED=false

# -----------------------------------------------------------------------------
# Payment - Direct (optioneel)
# Staat per tenant in het tenantbestand (modules.payment-direct en koppelingen.payment-direct), niet meer in
# Spring-properties; zie docker-compose/imports/tenants/00000099000000000001.yaml. Alleen de geheimen komen uit de
# omgeving, onder de OIN van de tenant (NL_PORTAL_GEHEIMEN_<OIN>_<NAAM>):
#NL_PORTAL_GEHEIMEN_00000099000000000001_PAYMENT_DIRECT_API_GEHEIM=
#NL_PORTAL_GEHEIMEN_00000099000000000001_PAYMENT_DIRECT_WEBHOOK_GEHEIM=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOGLEVEL=INFO

# -----------------------------------------------------------------------------
# Frontend toggles and properties (served to the SPA via GET /api/public/frontend).
# The toggles are feature flags: see imports/flags/nl-portal.flagd.json and
# site/hosting-en-configuratie/feature-flags.md.
# -----------------------------------------------------------------------------
NLPORTAL_FRONTEND_PROPERTIES_MESSAGECOUNTPOLLINGINTERVAL=10000
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWCURRENTCASESPREVIEWLENGTH=4
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWMAINTENANCEALERTTITLENL=Ontwikkelmodus
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWMAINTENANCEALERTTITLEEN=Development mode
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWMAINTENANCEALERTTEXTNL=Deze omgeving draait in ontwikkelmodus met testgegevens.
NLPORTAL_FRONTEND_PROPERTIES_OVERVIEWMAINTENANCEALERTTEXTEN=This environment is running in development mode with test data.
#NLPORTAL_FRONTEND_PROPERTIES_THEMECLASS=
#NLPORTAL_FRONTEND_PROPERTIES_MYADDRESSRESEARCHURL=
#NLPORTAL_FRONTEND_PROPERTIES_MYADDRESSRESEARCHMOREINFOURL=
#NLPORTAL_FRONTEND_PROPERTIES_MYADDRESSCHANGEURL=
#NLPORTAL_FRONTEND_PROPERTIES_MYNAMECHANGEURL=
#NLPORTAL_FRONTEND_PROPERTIES_MYGENDERCHANGEURL=
#NLPORTAL_FRONTEND_PROPERTIES_MYBRPCHANGEURL=
#NLPORTAL_FRONTEND_PROPERTIES_MYBRPCONFIDENTIALLYCHANGEURL=

# -----------------------------------------------------------------------------
# Beheerpoort: gedetailleerde modulestatus (GET /actuator/modulestatus)
# -----------------------------------------------------------------------------
# Eigen poort voor beheer, naast 8080; zonder deze variabele draait beheer op de gewone poort.
# Lokaal een {noop}-wachtwoord uit docker-compose/.env; gebruik elders een hash, zie site/hosting-en-configuratie/beheer-modulestatus.md
MANAGEMENT_SERVER_PORT=8091
NLPORTAL_BEHEER_GEBRUIKERSNAAM=beheer
# NLPORTAL_BEHEER_WACHTWOORDHASH komt uit docker-compose/.env (BACKEND_BEHEER_PASSWORD, gegenereerd door `mise run dev:setup`); zie compose.yaml.
