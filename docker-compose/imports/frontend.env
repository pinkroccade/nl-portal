# =============================================================================
# NL Portal Frontend Configuration
# =============================================================================
# Variables are injected into window.* at runtime via config.js/config.template.js.
# Pattern: window.VAR_NAME in browser, VAR_NAME in this file.
# Frontend features are configured on the backend (nl-portal.frontend.*,
# served via GET /api/public/frontend), not here.
# =============================================================================

# -----------------------------------------------------------------------------
# API Endpoints (required)
# Same-origin: de nginx van de frontend stuurt /graphql, /api, /oauth2, /login en /logout door naar de backend (BFF, ADR 0022).
# -----------------------------------------------------------------------------
GRAPHQL_URI=/graphql
REST_URI=/api

# -----------------------------------------------------------------------------
# Session Management (optional)
# De inactiviteitstijd volgt uit het tenantbestand; IDLE_TIMEOUT_MINUTES overschrijft hem alleen in de browser.
# Idle logout enabled by default. Set AUTO_IDLE_SESSION_LOGOUT to false to disable.
# -----------------------------------------------------------------------------
AUTO_IDLE_SESSION_LOGOUT=true
IDLE_TIMEOUT_MINUTES=
