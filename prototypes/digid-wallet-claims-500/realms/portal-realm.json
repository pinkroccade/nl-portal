{
  "realm": "portal",
  "enabled": true,
  "sslRequired": "none",
  "attributes": {
    "frontendUrl": "http://localhost:18080"
  },
  "authenticationFlows": [
    {
      "alias": "auto-broker-login",
      "description": "Eerste login via een broker: gebruiker zonder profielcontrole aanmaken of koppelen",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        },
        {
          "authenticator": "idp-auto-link",
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "nl-portal-backend",
      "enabled": true,
      "publicClient": false,
      "secret": "backend-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:18081/bff/callback"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "defaultClientScopes": [
        "basic",
        "web-origins",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "acr-van-idp",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "acr",
            "claim.name": "acr",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "inlogmiddel",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "identity_provider",
            "claim.name": "inlogmiddel",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "acting-subject-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "acting_subject_id",
            "claim.name": "acting_subject_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "acting-subject-id-wallet",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "bsn",
            "claim.name": "acting_subject_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "legal-subject-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "config": {
            "user.session.note": "legal_subject_id",
            "claim.name": "legal_subject_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "digid",
      "providerId": "saml",
      "enabled": true,
      "firstBrokerLoginFlowAlias": "auto-broker-login",
      "config": {
        "singleSignOnServiceUrl": "http://localhost:18080/realms/idp-sim/protocol/saml",
        "entityId": "http://localhost:18080/realms/portal",
        "nameIDPolicyFormat": "urn:oasis:names:tc:SAML:2.0:nameid-format:persistent",
        "postBindingAuthnRequest": "true",
        "postBindingResponse": "true",
        "wantAssertionsSigned": "true",
        "validateSignature": "true",
        "signingCertificate": "SETUP-VERVANGT-DIT",
        "syncMode": "FORCE",
        "authnContextClassRefs": "[\"urn:oasis:names:tc:SAML:2.0:ac:classes:MobileTwoFactorContract\"]",
        "authnContextComparisonType": "minimum"
      }
    },
    {
      "alias": "wallet",
      "providerId": "oidc",
      "enabled": true,
      "firstBrokerLoginFlowAlias": "auto-broker-login",
      "config": {
        "authorizationUrl": "http://localhost:18080/realms/idp-sim/protocol/openid-connect/auth",
        "tokenUrl": "http://localhost:18080/realms/idp-sim/protocol/openid-connect/token",
        "jwksUrl": "http://localhost:18080/realms/idp-sim/protocol/openid-connect/certs",
        "issuer": "http://localhost:18080/realms/idp-sim",
        "clientId": "portal-wallet-broker",
        "clientSecret": "wallet-sim-secret",
        "clientAuthMethod": "client_secret_post",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "defaultScope": "openid",
        "syncMode": "FORCE"
      }
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]}}],\"unmanagedAttributePolicy\":\"ENABLED\"}"
          ]
        }
      }
    ]
  },
  "identityProviderMappers": [
    {
      "name": "acr",
      "identityProviderAlias": "digid",
      "identityProviderMapper": "nlportal-saml-authncontext-note-mapper",
      "config": {
        "syncMode": "FORCE",
        "note": "acr"
      }
    },
    {
      "name": "acr",
      "identityProviderAlias": "wallet",
      "identityProviderMapper": "oidc-user-session-note-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claims": "[{\"key\":\"acr\",\"value\":\".*\"},{\"key\":\"bsn\",\"value\":\".*\"}]",
        "are.claim.values.regex": "true"
      }
    },
    {
      "name": "acting",
      "identityProviderAlias": "digid",
      "identityProviderMapper": "nlportal-saml-attribute-note-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute.name": "urn:nl-eid-gdi:1.0:ActingSubjectID",
        "note": "acting_subject_id"
      }
    },
    {
      "name": "legal",
      "identityProviderAlias": "digid",
      "identityProviderMapper": "nlportal-saml-attribute-note-mapper",
      "config": {
        "syncMode": "FORCE",
        "attribute.name": "urn:nl-eid-gdi:1.0:LegalSubjectID",
        "note": "legal_subject_id"
      }
    }
  ]
}
