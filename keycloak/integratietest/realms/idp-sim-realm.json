{
  "realm": "idp-sim",
  "enabled": true,
  "sslRequired": "none",
  "attributes": {
    "frontendUrl": "http://localhost:18080"
  },
  "users": [
    {
      "username": "jan",
      "enabled": true,
      "email": "jan@example.invalid",
      "emailVerified": true,
      "firstName": "Jan",
      "lastName": "Jansen",
      "attributes": {
        "acting_subject_id": [
          "999990008"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "jan"
        }
      ]
    },
    {
      "username": "maria",
      "enabled": true,
      "email": "maria@example.invalid",
      "emailVerified": true,
      "firstName": "Maria",
      "lastName": "Jansen",
      "attributes": {
        "acting_subject_id": [
          "999990020"
        ],
        "legal_subject_id": [
          "999990008"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "maria"
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "http://localhost:18080/realms/portal",
      "protocol": "saml",
      "enabled": true,
      "redirectUris": [
        "http://localhost:18080/realms/portal/broker/digid/endpoint"
      ],
      "attributes": {
        "saml.authnstatement": "true",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.client.signature": "false",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_name_id_format": "persistent",
        "saml_force_name_id_format": "true",
        "saml_assertion_consumer_url_post": "http://localhost:18080/realms/portal/broker/digid/endpoint",
        "acr.loa.map": "{\"urn:oasis:names:tc:SAML:2.0:ac:classes:PasswordProtectedTransport\":1,\"urn:oasis:names:tc:SAML:2.0:ac:classes:MobileTwoFactorContract\":2,\"urn:oasis:names:tc:SAML:2.0:ac:classes:Smartcard\":3,\"urn:oasis:names:tc:SAML:2.0:ac:classes:SmartcardPKI\":4}"
      },
      "protocolMappers": [
        {
          "name": "acting-subject-id",
          "protocol": "saml",
          "protocolMapper": "saml-user-attribute-mapper",
          "config": {
            "user.attribute": "acting_subject_id",
            "attribute.name": "urn:nl-eid-gdi:1.0:ActingSubjectID",
            "attribute.nameformat": "URI Reference"
          }
        },
        {
          "name": "legal-subject-id",
          "protocol": "saml",
          "protocolMapper": "saml-user-attribute-mapper",
          "config": {
            "user.attribute": "legal_subject_id",
            "attribute.name": "urn:nl-eid-gdi:1.0:LegalSubjectID",
            "attribute.nameformat": "URI Reference"
          }
        }
      ]
    },
    {
      "clientId": "portal-wallet-broker",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "secret": "wallet-sim-secret",
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://localhost:18080/realms/portal/broker/wallet/endpoint"
      ],
      "defaultClientScopes": [
        "web-origins",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "acr-eidas",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "config": {
            "claim.name": "acr",
            "claim.value": "http://eidas.europa.eu/LoA/high",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "acting-subject-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "acting_subject_id",
            "claim.name": "acting_subject_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "browserFlow": "sim-browser",
  "authenticationFlows": [
    {
      "alias": "sim-browser",
      "description": "Simuleert inloggen op niveau 1, 2 of 3 met stapsgewijs opschalen",
