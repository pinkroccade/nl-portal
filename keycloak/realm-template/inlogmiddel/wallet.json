{
  "identityProviders": [
    {
      "alias": "wallet",
      "displayName": "Wallet",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": false,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "auto-broker-login",
      "config": {
        "authorizationUrl": "{{idp.wallet.authorizationUrl}}",
        "tokenUrl": "{{idp.wallet.tokenUrl}}",
        "jwksUrl": "{{idp.wallet.jwksUrl}}",
        "issuer": "{{idp.wallet.issuer}}",
        "clientId": "{{idp.wallet.clientId}}",
        "clientSecret": "$(env:KEYCLOAK_WALLET_CLIENT_SECRET)",
        "clientAuthMethod": "client_secret_post",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "pkceEnabled": "true",
        "pkceMethod": "S256",
        "disableUserInfo": "true",
        "defaultScope": "openid",
        "syncMode": "FORCE"
      }
    }
  ],
  "identityProviderMappers": [
    { "name": "acr", "identityProviderAlias": "wallet", "identityProviderMapper": "nlportal-oidc-claim-note-mapper", "config": { "syncMode": "FORCE", "claim.name": "acr", "note": "acr" } },
    { "name": "acting", "identityProviderAlias": "wallet", "identityProviderMapper": "nlportal-oidc-claim-note-mapper", "config": { "syncMode": "FORCE", "claim.name": "acting_subject_id", "note": "acting_subject_id" } },
    { "name": "legal", "identityProviderAlias": "wallet", "identityProviderMapper": "nlportal-oidc-claim-note-mapper", "config": { "syncMode": "FORCE", "claim.name": "legal_subject_id", "note": "legal_subject_id" } },
    { "name": "gebruikersnaam", "identityProviderAlias": "wallet", "identityProviderMapper": "oidc-username-idp-mapper", "config": { "syncMode": "IMPORT", "template": "${ALIAS}.${CLAIM.sub}", "target": "LOCAL" } }
  ]
}
